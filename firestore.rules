rules_version = '2';

// Budget du Foyer — règles Firestore
//
// households/{hid}             foyer : name, owner, members[], memberEmails{uid: email}, memberProfiles{uid: {name, photo}}, createdAt
// households/{hid}/lines/{id}  lignes de budget
// users/{uid}                  { householdId, notify } : le foyer de chaque compte et ses réglages de rappels
// users/{uid}/devices/{id}     appareils abonnés aux notifications (Web Push)
// server/*                     réservé à l'envoi des rappels (aucun accès depuis l'appli)
// invites/{code}               code d'invitation à usage unique, expire après 7 jours
//
// Principe : seuls les membres d'un foyer lisent et écrivent ses données.
// On ne rejoint un foyer qu'en consommant un code d'invitation valide dans la même écriture groupée.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function householdAfter(hid) { return getAfter(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && me() in household(hid).members; }
    function validEmail(e) { return e is string && e.size() <= 254; }

    // ---------- foyers ----------
    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if false;

      // Création : je suis le seul membre et le propriétaire.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'memberEmails', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()]
        && request.resource.data.memberEmails.keys().hasOnly([me()])
        && validEmail(request.resource.data.memberEmails[me()])
        && request.resource.data.createdAt == request.time;

      // Un membre renomme le foyer.
      allow update: if isMember(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;

      // Rejoindre : je m'ajoute moi seul, avec un code valide pour CE foyer, consommé dans la même écriture.
      allow update: if signedIn()
        && !(me() in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails', 'joinCode'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && me() in request.resource.data.members
        && request.resource.data.members.size() <= 6
        && request.resource.data.memberEmails.diff(resource.data.memberEmails).affectedKeys().hasOnly([me()])
        && validEmail(request.resource.data.memberEmails[me()])
        && request.resource.data.joinCode is string
        && validInviteFor(request.resource.data.joinCode, hid);

      // Un membre modifie son propre profil (prénom, photo) et seulement le sien.
      allow update: if isMember(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberProfiles'])
        && (!('memberProfiles' in resource.data)
            || request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([me()]))
        && (('memberProfiles' in resource.data) || request.resource.data.memberProfiles.keys().hasOnly([me()]))
        && validProfile(request.resource.data.memberProfiles[me()]);

      allow delete: if false;

      // ---------- lignes de budget ----------
      match /lines/{lineId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && validLine(request.resource.data);
        allow delete: if isMember(hid);
      }
    }

    function validInviteFor(code, hid) {
      let inv = get(/databases/$(database)/documents/invites/$(code)).data;
      let invAfter = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return inv.hid == hid
        && inv.usedBy == null
        && inv.expiresAt > request.time
        && invAfter.usedBy == me();
    }

    // Photo : image redimensionnée (data URL, ~20 Ko) ou photo de profil Google (https).
    function validProfile(p) {
      return p is map && p.keys().hasOnly(['name', 'photo'])
        && (!('name' in p) || (p.name is string && p.name.size() <= 40))
        && (!('photo' in p) || (p.photo is string && p.photo.size() <= 80000
            && (p.photo.matches('^data:image/(jpeg|png|webp);base64,.*') || p.photo.matches('^https://.*'))));
    }

    function validLine(d) {
      return d.keys().hasOnly(['kind', 'label', 'amount', 'freq', 'cat', 'due', 'end', 'parts', 'variable', 'saved', 'pro', 'example', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['kind', 'label', 'amount', 'freq', 'cat'])
        && d.kind in ['income', 'expense']
        && d.label is string && d.label.size() > 0 && d.label.size() <= 60
        && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount < 10000000
        && d.freq in ['weekly', 'monthly', 'multi', 'bimonthly', 'quarterly', 'semiannual', 'annual', 'once']
        && d.cat is string && d.cat.size() <= 40
        && (!('due' in d) || (d.due is string && d.due.size() <= 10))
        && (!('parts' in d) || (d.parts is list && d.parts.size() <= 12))
        && (!('variable' in d) || d.variable is bool)
        && (!('end' in d) || (d.end is string && d.end.size() <= 10))
        && (!('saved' in d) || ((d.saved is int || d.saved is float) && d.saved >= 0 && d.saved < 10000000))
        && (!('pro' in d) || (d.pro is int && d.pro >= 0 && d.pro <= 100))
        && (!('example' in d) || d.example is bool)
        && (!('createdAt' in d) || d.createdAt is int || d.createdAt is float)
        && (!('updatedAt' in d) || d.updatedAt is int || d.updatedAt is float);
    }

    // ---------- comptes ----------
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      // Je ne peux pointer que vers un foyer dont je suis membre (après l'écriture groupée).
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['householdId', 'notify'])
        && request.resource.data.householdId is string
        && (!('notify' in request.resource.data) || validNotify(request.resource.data.notify))
        && me() in householdAfter(request.resource.data.householdId).members;
      allow delete: if signedIn() && me() == uid;

      // Appareils abonnés aux rappels : chacun gère uniquement les siens.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'ua', 'createdAt'])
          && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 1000
          && request.resource.data.endpoint.matches('^https://.*')
          && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth'])
          && request.resource.data.keys.p256dh is string && request.resource.data.keys.p256dh.size() <= 200
          && request.resource.data.keys.auth is string && request.resource.data.keys.auth.size() <= 100
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
          && request.resource.data.createdAt is int;
      }
    }

    function validNotify(n) {
      return n is map && n.keys().hasOnly(['before3', 'sameDay', 'income'])
        && (!('before3' in n) || n.before3 is bool)
        && (!('sameDay' in n) || n.sameDay is bool)
        && (!('income' in n) || n.income is bool);
    }

    // ---------- invitations ----------
    match /invites/{code} {
      // Lire un code précis (pas lister) : il faut le connaître.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.size() == 8
        && request.resource.data.keys().hasOnly(['hid', 'createdBy', 'createdAt', 'expiresAt', 'usedBy'])
        && isMember(request.resource.data.hid)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.usedBy == null;

      // Consommer : une seule fois, par moi, et seulement si je deviens membre dans la même écriture.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == me()
        && me() in householdAfter(resource.data.hid).members;

      allow delete: if signedIn() && resource.data.createdBy == me();
    }
  }
}
